# ==========================================
# ROADRESQ — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before running docker-compose
# DO NOT COMMIT THE REAL .env FILE TO GIT
# ==========================================

# Application Settings
APP_ENV=development
APP_NAME=RoadResQ
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=dev_secret_key_change_in_production_32_bytes

# Backend Service
BACKEND_PORT=8000

# Web Applications Ports
CUSTOMER_WEB_PORT=3000
PROVIDER_WEB_PORT=3001
ADMIN_WEB_PORT=3002

# PostgreSQL + PostGIS Configuration
POSTGRES_USER=roadresq_user
POSTGRES_PASSWORD=roadresq_password
POSTGRES_DB=roadresq_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://roadresq_user:roadresq_password@postgres:5432/roadresq_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Authentication & Security
JWT_SECRET=dev_jwt_secret_key_roadresq_2026_change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Third-Party API Key Placeholders (Planned for Phase 1+)
MAPS_API_KEY=your_maps_api_key_placeholder
PAYMENT_GATEWAY_KEY=your_payment_gateway_key_placeholder
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_placeholder
STORAGE_ACCESS_KEY=your_storage_access_key_placeholder
STORAGE_SECRET_KEY=your_storage_secret_key_placeholder
STORAGE_BUCKET_NAME=roadresq-dev-assets
